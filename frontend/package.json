{
  "name": "networkbuster-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.networkbuster.desktop",
    "productName": "NetworkBuster",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
